# Template for deploy/.env.prod (gitignored, never leaves this workstation).
#
#     copy deploy\.env.example deploy\.env.prod
#     deploy-droplet check
#
# Any value may be a 1Password reference instead (op://Vault/Item/field); it is
# read with `op read` at the moment it is needed and never written to disk.
# Nothing in this file is a secret to the *site* -- the running container gets
# only the "Site settings" block. The credentials block stays here.

# --- Target (required; there is no default droplet) ---------------------------

# The droplet's IP. Must not be financesite's droplet unless you co-host the
# way ARCHITECTURE.md describes -- both stacks want ports 80 and 443.
BIRD_DEPLOY_HOST=
# The hostname with an A record pointing at that IP. Caddy gets the cert for it.
BIRD_DEPLOY_SITE_DOMAIN=
# Optional overrides (defaults shown):
# BIRD_DEPLOY_USER=root
# BIRD_DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# BIRD_DEPLOY_IMAGE=birdheaven-web
# BIRD_DEPLOY_HTTPS_PORT=443
# BIRD_DEPLOY_PORT80_MODE=redirect      # "passthrough" only during bring-up

# --- Site settings (passed to the web container) -------------------------------

# Public URL of catalog.json in the Spaces bucket. Use the CDN endpoint:
#   https://<bucket>.<region>.cdn.digitaloceanspaces.com/catalog.json
CATALOG_URL=
# Prefix for media paths in the catalog. Blank = the catalog's own directory,
# which is right unless you put a custom CDN domain in front of the bucket.
MEDIA_BASE_URL=
SITE_NAME=Bird Heaven
SITE_TAGLINE=Live from the backyard feeders
# Shown in the footer as "Filmed in ...". Blank hides it.
LOCATION_LABEL=
# PayPal > Pay & Get Paid > Accept Donations > Donate Button. After creating
# it, the ID is the `hosted_button_id` value in the generated code. Blank hides
# the donate panel.
PAYPAL_HOSTED_BUTTON_ID=

# Live video stub (see app/birdheaven/live.py). Offline until a streaming
# server exists. kind: hls | video | iframe
LIVE_STATUS=offline
LIVE_KIND=
LIVE_URL=
LIVE_TITLE=Feeder cam

LOG_LEVEL=INFO

# --- Workstation credentials (never passed to the containers) -------------------

# Spaces access key for tools/publish.py (API > Spaces Keys). Scope it to the
# one bucket if you can.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=birdheaven
SPACES_REGION=nyc3
