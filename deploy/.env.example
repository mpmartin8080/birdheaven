# Template for deploy/.env.prod (gitignored, never committed).
#
#     copy deploy\.env.example deploy\.env.prod
#     deploy-droplet admin-password --enable     (sets the admin secrets below)
#     deploy-droplet check
#
# Any value may be a 1Password reference instead (op://Vault/Item/field); it is
# read with `op read` at the moment it is needed and never written to disk.
#
# Who gets what: the public `web` container receives only the "Site defaults"
# block (nothing secret). The `admin` container receives the "Admin console"
# block. Target settings stay on this workstation.

# --- Target (required; there is no default droplet) ---------------------------

# The droplet's IP. Must not be financesite's droplet unless you co-host the
# way ARCHITECTURE.md describes -- both stacks want ports 80 and 443.
BIRD_DEPLOY_HOST=
# The public hostname (A record -> the droplet). Caddy gets its cert.
BIRD_DEPLOY_SITE_DOMAIN=
# The admin console is served on the same hostname at this port:
# https://<BIRD_DEPLOY_SITE_DOMAIN>:7777/. Same certificate, no extra DNS.
# Open it in the Cloud Firewall (your own IP is enough) and re-run `bootstrap`
# after changing it.
# BIRD_DEPLOY_ADMIN_PORT=7777
# Optional overrides (defaults shown):
# BIRD_DEPLOY_USER=root
# BIRD_DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# BIRD_DEPLOY_IMAGE=birdheaven-web
# BIRD_DEPLOY_ADMIN_IMAGE=birdheaven-admin
# BIRD_DEPLOY_HTTPS_PORT=443
# BIRD_DEPLOY_PORT80_MODE=redirect      # "passthrough" only during bring-up

# --- Site defaults (passed to the web container) --------------------------------

# Public URL of catalog.json in the Spaces bucket. site-settings.json (written
# by the admin console) is read from the same place.
#   CDN:    https://<bucket>.<region>.cdn.digitaloceanspaces.com/catalog.json
#   Origin: https://<bucket>.<region>.digitaloceanspaces.com/catalog.json
#           (the origin URL skips the CDN cache, so admin changes show sooner)
CATALOG_URL=
# Prefix for media paths in the catalog. Blank = the catalog's own directory,
# which is right unless you put a custom CDN domain in front of the bucket.
MEDIA_BASE_URL=
# Everything below is a DEFAULT. Once you save the admin console's Site
# settings page, its values win, and these are only used for anything it
# leaves blank.
SITE_NAME=Bird Heaven
SITE_TAGLINE=Live from the backyard feeders
LOCATION_LABEL=
PAYPAL_HOSTED_BUTTON_ID=
LIVE_STATUS=offline
LIVE_KIND=
LIVE_URL=
LIVE_TITLE=Feeder cam

LOG_LEVEL=INFO

# --- Admin console (passed to the admin container only) -------------------------

# Signs admin session cookies. 48+ random characters; `deploy-droplet
# admin-password` generates it. Rotating it signs every admin session out.
ADMIN_SESSION_KEY=

# THE RECOVERY SWITCH. false (default): passkeys only -- the password sign-in
# does not exist. true: the sign-in page also accepts the recovery password.
# Turn it on to register your first passkey or to recover after losing them
# all, run `deploy-droplet up`, do what you need, then set it back to false
# and run `deploy-droplet up` again (which also ends any password sessions).
ADMIN_PASSWORD_LOGIN=false

# Argon2id hash of the recovery password (never the password itself). Set it
# with `deploy-droplet admin-password`. Safe to leave here while the switch is
# off; it is only checked while the switch is on.
ADMIN_PASSWORD_HASH=

# Spaces access key (API > Spaces Keys), scoped to the one bucket if you can.
# The admin console uploads with it; tools/publish.py uses it from here too.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=birdheaven
SPACES_REGION=nyc3
